{
  "name": "neuroinsight-intro-hyperframes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs && hyperframes check",
    "render": "node build.mjs && HYPERFRAMES_FFMPEG_PATH=$PWD/node_modules/ffmpeg-static/ffmpeg HYPERFRAMES_FFPROBE_PATH=$PWD/node_modules/ffprobe-static/bin/darwin/arm64/ffprobe hyperframes render -o renders/intro-redes-9x16.mp4 --crf 20"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "hyperframes": "0.8.206"
  }
}
